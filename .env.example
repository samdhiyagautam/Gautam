# Supabase (get these from https://supabase.com/dashboard/project/_/settings/api)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Site (production URL on Vercel, e.g. https://your-name.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Your Name Portfolio

# Admin (must match your Supabase Auth user email AND the admin_users row)
ADMIN_EMAIL=your_email@example.com

# Storage (bucket name created by migration 001)
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=portfolio-assets

# Contact delivery (https://resend.com/api-keys) — optional, form shows
# a mailto fallback until these are set
RESEND_API_KEY=
CONTACT_TO_EMAIL=your_email@example.com
# CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
